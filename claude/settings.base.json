{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/require-approved-plan.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/secret-scan.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/guard-deploy.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/secret-scan.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
